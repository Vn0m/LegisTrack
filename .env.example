# Values with special characters (&, ?, spaces) must be single-quoted.
DATABASE_URL='jdbc:postgresql://db.xxx.supabase.co:5432/postgres'
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password
SUPABASE_URL=https://xxx.supabase.co
# Only needed while the Supabase project still signs tokens with the legacy
# HS256 shared secret (Dashboard -> Project Settings -> API -> JWT Secret).
# After rotating to an asymmetric signing key, leave this unset.
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NY_SENATE_API_KEY=your_ny_senate_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your_account_id/your_queue_name
